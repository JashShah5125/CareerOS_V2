{
  "manifest_version": 3,
  "name": "CareerOS Job Clipper",
  "version": "1.0.0",
  "description": "Clip and import job descriptions from LinkedIn and Naukri directly into your CareerOS Kanban Board.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "http://localhost:3000/*",
    "http://localhost:5001/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.naukri.com/*",
        "http://localhost:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"]
    }
  ]
}
